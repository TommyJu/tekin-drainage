---
// Move your job-site photos into src/assets/images/gallery/ and import each
// one below. Static imports are what let Astro optimize/resize them —
// this is the fix for the old carousel's raw, unresized phone photos.
import { Image } from "astro:assets";
import photo1 from "@assets/images/gallery/job-01.jpg";
import photo2 from "@assets/images/gallery/job-02.jpg";
import photo3 from "@assets/images/gallery/job-03.jpg";
import photo4 from "@assets/images/gallery/job-04.jpg";
import photo5 from "@assets/images/gallery/job-05.jpg";
import photo6 from "@assets/images/gallery/job-06.jpg";
import photo7 from "@assets/images/gallery/job-07.jpg";
import photo8 from "@assets/images/gallery/job-08.jpg";
import photo9 from "@assets/images/gallery/job-09.jpg";
import photo10 from "@assets/images/gallery/job-10.jpg";
import photo11 from "@assets/images/gallery/job-11.jpg";
import photo12 from "@assets/images/gallery/job-12.jpg";
import photo13 from "@assets/images/gallery/job-13.jpg";
import photo14 from "@assets/images/gallery/job-14.jpg";
import photo15 from "@assets/images/gallery/job-15.jpg";
import photo16 from "@assets/images/gallery/job-16.jpg";

const photos = [
  { src: photo1, alt: "Residential drainage repair project" },
  { src: photo2, alt: "Professional plumbing service" },
  { src: photo3, alt: "Drainage system installation" },
  { src: photo4, alt: "Completed plumbing repair" },
  { src: photo5, alt: "Residential plumbing maintenance" },
  { src: photo6, alt: "Drain cleaning service" },
  { src: photo7, alt: "Plumbing installation project" },
  { src: photo8, alt: "Residential drainage work" },
  { src: photo9, alt: "Professional plumbing repair" },
  { src: photo10, alt: "Completed drainage project" },
  { src: photo11, alt: "Drainage maintenance service" },
  { src: photo12, alt: "Residential plumbing work" },
  { src: photo13, alt: "Drain repair and maintenance" },
  { src: photo14, alt: "Professional plumbing installation" },
  { src: photo15, alt: "Completed residential plumbing project" },
  { src: photo16, alt: "Drainage system repair" },
];
---

<section id="gallery">
  <div class="section-inner">
    <p class="eyebrow">Recent work</p>
    <h2>Reliable solutions for every plumbing challenge</h2>

    <div class="gallery-grid">
      {photos.map((photo) => (
        <div class="gallery-item">
          <Image src={photo.src} alt={photo.alt} width={480} height={360} loading="lazy" />
        </div>
      ))}
    </div>
  </div>
</section>

<style lang="less">
  #gallery {
    padding: 4.5rem 1.25rem;
    background: var(--white);

    .section-inner {
      max-width: 1100px;
      margin: 0 auto;
    }

    .eyebrow {
      font-family: var(--font-display);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: 0.85rem;
      color: var(--amber-dark);
      font-weight: 700;
      margin-bottom: 0.5rem;
    }

    h2 {
      font-family: var(--font-display);
      font-size: clamp(1.75rem, 3vw, 2.25rem);
      color: var(--teal-dark);
      margin: 0 0 2rem;
    }

    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem;
    }

    .gallery-item {
      border-radius: 10px;
      overflow: hidden;
      aspect-ratio: 4 / 3;

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.3s ease;
      }

      &:hover img {
        transform: scale(1.04);
      }
    }
    
  }
</style>
