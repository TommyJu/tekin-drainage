---
import { BUSINESS } from "@data/client";
---

<section id="top" class="hero">
  <div class="hero-inner">
    <p class="eyebrow">24/7 Emergency Service &middot; Lower Mainland &amp; Fraser Valley</p>
    <h1>Plumbing &amp; Drain Specialists</h1>
    <p class="subtext">
      Solutions for your residential or commercial property, satisfaction guaranteed.
      Over 18 years of experience means our technicians have the tools to get it right
      the first time.
    </p>

    <div class="hero-actions">
      <a class="btn btn-primary" href={BUSINESS.phoneHref}>Call {BUSINESS.phoneDisplay}</a>
      <a class="btn btn-secondary" href={BUSINESS.emailHref}>Email Us</a>
    </div>
  </div>

  <svg class="flow-line" viewBox="0 0 1200 80" preserveAspectRatio="none" aria-hidden="true">
    <path
      d="M0 40 C 150 10, 300 70, 450 40 S 750 10, 900 40 S 1100 70, 1200 40"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      pathLength="1"
    />
  </svg>
</section>

<style lang="less">
  .hero {
    position: relative;
    background: linear-gradient(180deg, var(--teal-dark) 0%, var(--teal) 100%);
    color: var(--white);
    padding: 5rem 1.25rem 6rem;
    overflow: hidden;

    .hero-inner {
      max-width: 780px;
      margin: 4rem auto;
      text-align: center;
    }

    .eyebrow {
      font-family: var(--font-display);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: 0.85rem;
      color: var(--amber);
      font-weight: 700;
      margin-bottom: 1rem;
    }

    h1 {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: clamp(2.25rem, 5vw, 3.5rem);
      line-height: 1.05;
      margin: 0 0 1.25rem;
    }

    .subtext {
      font-size: 1.05rem;
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.85);
      max-width: 560px;
      margin: 0 auto 2rem;
    }

    .hero-actions {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    .btn {
      padding: 0.85rem 1.75rem;
      border-radius: 999px;
      font-weight: 700;
      text-decoration: none;
      font-size: 1rem;
      transition: transform 0.15s ease;

      &:hover {
        transform: translateY(-1px);
      }
    }

    .btn-primary {
      background: var(--amber);
      color: var(--white);

      &:hover {
        background: var(--amber-dark);
      }
    }

    .btn-secondary {
      background: transparent;
      color: var(--white);
      border: 1.5px solid rgba(255, 255, 255, 0.5);

      &:hover {
        border-color: var(--white);
      }
    }

    .flow-line {
      position: absolute;
      bottom: -1px;
      left: 0;
      width: 100%;
      height: 60px;
      color: rgba(232, 130, 61, 0.35);

      path {
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
        animation: draw-flow 2.2s ease forwards 0.3s;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .flow-line path {
        animation: none;
        stroke-dashoffset: 0;
      }
    }
  }

  @keyframes draw-flow {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
