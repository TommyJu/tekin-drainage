---
import { BUSINESS } from "@data/client";
---

<footer>
  <div class="footer-inner">
    <p>
      © {new Date().getFullYear()} Tekin Plumbing &amp; Drainage Services
    </p>

    <div class="footer-contact">
      <a href={BUSINESS.phoneHref}>
        {BUSINESS.phoneDisplay}
      </a>

      <span>•</span>

      <a href={BUSINESS.emailHref}>
        {BUSINESS.email}
      </a>
    </div>

    <p class="credit">
      Website by&nbsp;
      <a
        href="https://github.com/tommyju"
        target="_blank"
        rel="noopener noreferrer"
      >
        Tommy Ju
      </a>
    </p>
  </div>
</footer>

<style>
  footer {
  background: #08181d;
  padding: 1.5rem 1.25rem;
  color: rgba(255,255,255,0.7);

  .footer-inner {
    max-width: 1100px;
    margin: 0 auto;

    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  p {
    font-size: 0.9rem;
    color: var(--white)
  }

  .footer-contact {
    display: flex;
    gap: 0.75rem;
    align-items: center;

    a {
      color: var(--white);
      text-decoration: none;

      &:hover {
        color: var(--amber);
      }
    }
  }

  .credit a {
    color: var(--amber);
    text-decoration: none;
  }
}
</style>
